# Copy this file to ".env" and fill in your real keys. ".env" is git-ignored.
# `python3 -m crew doctor` で、どの鍵が読めているか確認できます。

# --- Kling AI (動画生成MCP。AI社員組織とは無関係) ---
KLING_ACCESS_KEY=your_access_key_here
KLING_SECRET_KEY=your_secret_key_here

# --- Claude Code株式会社 (engine: claude) ---
# 通常は `claude` コマンドのログインで足りる。API鍵で動かす場合のみ設定。
# ANTHROPIC_API_KEY=

# --- Codex株式会社 (engine: codex) ---
# OPENAI_API_KEY=

# --- 発注本部長 (engine: gemini) ---
# 無料枠のAPIキー: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
